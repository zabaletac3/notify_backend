# Copia a .env (nunca se sube). Los secretos reales viven solo en cada servidor.
APP_ENV=dev                       # dev | qa | prod
PORT=8080
LOG_LEVEL=debug
DATABASE_URL=postgres://apunte:apunte@localhost:5432/apunte?sslmode=disable
# Mínimo 32 caracteres y distintos entre sí. Genera con: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-123456
PEPPER=cambia-esto-por-otro-secreto-distinto-largo-y-aleatorio
ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false                 # true detrás de Caddy (qa/prod)
# Cookie de sesión web (modo cookie, cabecera X-Apunte-Session: cookie).
# COOKIE_SECURE: por defecto true; false solo en dev (en qa/prod debe ser true).
# COOKIE_DOMAIN: opcional; vacío = cookie solo para el host de la API (recomendado).
# COOKIE_SECURE=false
# COOKIE_DOMAIN=
WEB_BASE_URL=http://localhost:5173 # enlaces de los correos (https en prod)
ACCESS_TTL=15m
REFRESH_TTL=720h
# JWT_SECRET_PREVIOUS=            # solo durante una rotación del secreto
# Correo: log (dev/qa) | resend | smtp (prod admite resend y smtp, no log)
MAIL_PROVIDER=log
MAIL_FROM=Apunte <no-reply@localhost>
RESEND_API_KEY=
# SMTP (MAIL_PROVIDER=smtp). 587 = STARTTLS (obligatorio); 465 = TLS implícito.
# Gmail: smtp.gmail.com + contraseña de aplicación; MAIL_FROM debe ser la misma cuenta.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# Solo para `make migrate` (rol dueño del esquema; la API nunca lo usa)
MIGRATE_DATABASE_URL=postgres://apunte:apunte@localhost:5432/apunte?sslmode=disable
MAX_SYNC_BODY_BYTES=8388608
QUOTA_BYTES=1073741824          # 1 GiB de textos cifrados por cuenta
