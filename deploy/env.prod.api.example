# /etc/apunte/prod.api.env  (chmod 600, dueño root): lo ÚNICO que ve el contenedor de la API.
APP_ENV=prod
PORT=8080
LOG_LEVEL=info
TRUST_PROXY=true
WEB_BASE_URL=https://app.tudominio.com
ALLOWED_ORIGINS=https://app.tudominio.com
# Cookie de sesión web (modo cookie). En prod COOKIE_SECURE debe ser true.
# COOKIE_DOMAIN vacío = cookie solo para api.tudominio.com (web y API comparten dominio registrable).
COOKIE_SECURE=true
# COOKIE_DOMAIN=
# Rol de la API: sin DDL y sujeto a RLS (la contraseña es API_PASSWORD de prod.env)
DATABASE_URL=postgres://apunte_api:CONTRASEÑA_API@postgres:5432/apunte?sslmode=disable
# openssl rand -base64 48   (distintos entre sí y de los del otro ambiente)
JWT_SECRET=
PEPPER=
# resend | smtp
MAIL_PROVIDER=resend
MAIL_FROM=AxoNote <no-reply@tudominio.com>
RESEND_API_KEY=
# Con MAIL_PROVIDER=smtp (p. ej. Gmail con contraseña de aplicación; MAIL_FROM = la misma cuenta):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
