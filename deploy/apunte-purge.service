[Unit]
Description=Purga diaria de AxoNote (papelera, cuentas eliminadas, sesiones caducadas)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# /etc/apunte/prod.purge.env: PURGE_DATABASE_URL (rol apunte_purge) y, opcional, PURGE_PING_URL.
# Corre en la red interna de la pila de prod, con la misma imagen que la API (trae /purge).
ExecStart=/bin/bash -c 'exec docker run --rm --read-only --cap-drop ALL --security-opt no-new-privileges --env-file /etc/apunte/prod.purge.env --network apunte-prod_internal --network-alias purge --entrypoint /purge ghcr.io/zabaletac3/notify_backend:$(cat /opt/apunte/state/prod/current)'
