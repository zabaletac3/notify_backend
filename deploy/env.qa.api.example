# /etc/apunte/qa.api.env  (chmod 600, dueño root): lo ÚNICO que ve el contenedor de la API.
APP_ENV=qa
PORT=8080
LOG_LEVEL=debug
TRUST_PROXY=true
WEB_BASE_URL=https://qa.tudominio.com
ALLOWED_ORIGINS=https://qa.tudominio.com
# Rol de la API: sin DDL y sujeto a RLS (la contraseña es API_PASSWORD de qa.env)
DATABASE_URL=postgres://apunte_api:CONTRASEÑA_API@postgres:5432/apunte?sslmode=disable
# openssl rand -base64 48   (distintos entre sí y de los del otro ambiente)
JWT_SECRET=
PEPPER=
MAIL_PROVIDER=log
MAIL_FROM=Apunte <no-reply@tudominio.com>
# En QA el correo va al log (los códigos se leen con `docker compose logs api`); nunca datos reales.
