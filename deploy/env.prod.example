# /etc/apunte/prod.env  (chmod 600, dueño root): variables de la PILA (compose y scripts). NO llegan a la API.
# Los secretos de PROD deben ser distintos de los del otro ambiente.
ENV_NAME=prod
API_ENV_FILE=/etc/apunte/prod.api.env
# IMAGE_TAG lo fija deploy/release.sh en cada despliegue.

# Postgres: el superusuario solo lo usa init-db.sh; el dueño del esquema solo las migraciones.
POSTGRES_PASSWORD=
OWNER_PASSWORD=
API_PASSWORD=
PURGE_PASSWORD=
BACKUP_PASSWORD=
MIGRATE_DATABASE_URL=postgres://apunte_owner:CONTRASEÑA_OWNER@postgres:5432/apunte?sslmode=disable
